rules_version = '2';
// Pravidla pro Firestore. Nasazují se automaticky s webem (firebase.json),
// případně je lze vložit ručně do Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Správci, kteří na /?admin stahují kontakty. Stejný seznam je v src/config.ts (ADMIN_EMAILS).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'databali4market@gmail.com'
        ];
    }

    // Profil a postup uživatele: každý čte a zapisuje jen svůj dokument, správce čte všechny.
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'newsletter', 'newsletterAt', 'newsletterConsent',
             'newsletterRevokedAt', 'createdAt', 'lastSeenAt', 'opened', 'openedPreview', 'entries', 'entriesPreview'])
        && request.resource.data.email == request.auth.token.email.lower()
        && (!('newsletter' in request.resource.data) || request.resource.data.newsletter is bool);
      allow delete: if false;
    }

    // Soutěžní odpovědi: jen vlastní, jen jednou (bez úprav), max. 1000 znaků. Správce čte všechny.
    match /entries/{entryId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && entryId.matches(request.auth.uid + '_(nahled_)?[0-9]+')
        && request.resource.data.answer is string
        && request.resource.data.answer.size() >= 1
        && request.resource.data.answer.size() <= 1000
        && request.resource.data.day in [5, 13, 19];
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }
  }
}
